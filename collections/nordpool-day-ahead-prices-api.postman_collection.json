            },
            "url": {
              "path": [
                "api",
                "DayAheadPrices"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "date",
                  "value": "<date>",
                  "description": "(Required) Delivery date (CET), format yyyy-MM-dd."
                },
                {
                  "disabled": false,
                  "key": "market",
                  "value": "<string>",
                  "description": "(Required) Market to query. DayAhead is the day-ahead auction market."
                },
                {
                  "disabled": false,
                  "key": "deliveryArea",
                  "value": "<string>",
                  "description": "(Required) Comma-separated bidding/delivery area codes, for example NO2 or SE3,FI,DK1."
                },
                {
                  "disabled": false,
                  "key": "currency",
                  "value": "<string>",
                  "description": "(Required) Currency for returned prices (EUR or a local currency such as NOK, SEK, DKK)."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
